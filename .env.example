# Environment variables for replication.
# Copy this file to `.env` and fill in your own keys. Never commit `.env`.

# ---------------------------------------------------------------------------
# REQUIRED — used by scripts/enrich_tvl_oracle_prices.py and the dRPC URLs
# in code/config/csu_config.yaml (expanded at load time by collect_tvl_parallel.py).
# Get a key at https://drpc.org/
# ---------------------------------------------------------------------------
DRPC_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — config/rpc_pool_v2.py uses a multi-provider failover pool.
# Set as many of the following as you have. None are required if you only
# use DRPC_KEY above.
# ---------------------------------------------------------------------------

# Numbered Alchemy keys (rotated round-robin)
# ALCHEMY_KEY_1=
# ALCHEMY_KEY_2=

# Numbered dRPC keys
# DRPC_KEY_1=
# DRPC_KEY_2=

# Per-chain dRPC keys
# DRPC_KEY_ETHEREUM=
# DRPC_KEY_ARBITRUM=
# DRPC_KEY_BASE=
# DRPC_KEY_OPTIMISM=
# DRPC_KEY_POLYGON=

# Per-chain BlockPI keys
# BLOCKPI_KEY_ETHEREUM=
# BLOCKPI_KEY_ARBITRUM=
# BLOCKPI_KEY_BASE=

# Single-key fallback used by config/rpc_config.py
# ALCHEMY_API_KEY=

# CoinGecko (price service)
# COINGECKO_API_KEY=
