# =============================================================================
# Thesis replication .gitignore
#
# Default-deny generic data/binary patterns. Canonical replication artifacts
# are added explicitly with `git add -f` (see paths in README.md).
# =============================================================================

# Raw and intermediate data layers (regenerable from RPC; not in git)
data/bronze/
data/silver/
data/cache/
data/reference/

# Working artifacts (not part of replication)
archive/
presentation/
context/
output/
notebooks/
poster_*
~$*

# LaTeX intermediates
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
texput.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
env/
*.ipynb_checkpoints/

# Secrets
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Default-deny generic data and binary formats.
# Canonical replication files in data/, results/, paper/ are tracked
# via `git add -f` and remain in git regardless of these patterns.
*.parquet
*.xlsx
*.csv
*.json
!package.json
*.pdf
*.png
*.jpg
*.jpeg
*.gif
